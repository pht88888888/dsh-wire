{
	"name": "dsh-wire",
	"version": "0.3.6",
	"description": "把电脑上的 DSH 会话接到手机：手机直连电脑读取真实会话，不做本地镜像。公网只传文本。",
	"type": "module",
	"main": "lib/index.js",
	"exports": {
		".": "./lib/index.js",
		"./client": "./lib/client-ui.js"
	},
	"files": [
		"lib",
		"server",
		"cordis.patch.yml"
	],
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"test": "node --test test/*.test.mjs"
	},
	"keywords": [
		"dsh",
		"dsh-plugin",
		"remote",
		"tunnel"
	],
	"license": "MIT",
	"dsh": {
		"plugin": true,
		"bundle": {
			"patch": "./cordis.patch.yml"
		},
		"client": {
			"inject": [],
			"platform": "web",
			"immediately": true
		}
	}
}
